# Python bytecode caches
__pycache__/
*.pyc

# Scratch / reproduction harnesses (evidence is recorded in reports/, not here)
_synth_test/

# Publication contract tooling
tools/publication-contract/node_modules/
tools/publication-contract/coverage/
tools/publication-contract/export-output/

# Export scratch output (reproducible from `npm run export`; never tracked)
.publication-build/
.publication-build-*/
.publication-stage-*/
publication/.export-stage-*/
publication/export-*/

# Root has no package.json — a root package-lock.json is a stray artifact, not the real lockfile
/package-lock.json

# Local workflow notes and reproducible PDF reading copies (never publish)
/.research-local/

# Private reviewer deployment configuration and local secret overrides
/tools/reviewer-gateway/wrangler.local.jsonc
/tools/reviewer-gateway/.dev.vars*
/tools/reviewer-gateway/.env*
