{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "criteria": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bands": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "definition": {
                  "minLength": 1,
                  "type": "string"
                },
                "label": {
                  "minLength": 1,
                  "type": "string"
                },
                "score": {
                  "maximum": 5,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "score",
                "label",
                "definition"
              ],
              "type": "object"
            },
            "maxItems": 5,
            "minItems": 5,
            "type": "array"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "higherIsMoreFavorable": {
            "const": true,
            "type": "boolean"
          },
          "id": {
            "enum": [
              "evidence-strength",
              "process-ease",
              "resource-burden",
              "contaminant-fate-coverage",
              "sink-completeness",
              "product-readiness",
              "regulatory-clarity",
              "validation-maturity"
            ],
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "unknownRule": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "higherIsMoreFavorable",
          "unknownRule",
          "bands"
        ],
        "type": "object"
      },
      "maxItems": 8,
      "minItems": 8,
      "type": "array"
    },
    "rubricVersion": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "schemaVersion",
    "rubricVersion",
    "criteria"
  ],
  "type": "object"
}
