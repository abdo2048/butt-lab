---
interface Props {
  status: "scored" | "unknown" | "not-applicable";
  score?: number | undefined;
}

const { status, score } = Astro.props;
const filled = status === "scored" ? Math.min(5, Math.max(1, score ?? 1)) : 0;
const marks = Array.from({ length: 5 }, (_, index) => index < filled);
---

<span class={`ticks ticks--${status}`} aria-hidden="true">
  {marks.map((on, index) => (
    <span class={`tick ${on ? "tick--on" : status === "not-applicable" ? "tick--na" : ""}`}></span>
  ))}
</span>
