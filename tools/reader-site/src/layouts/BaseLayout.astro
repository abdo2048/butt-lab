---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  layout?: "wide" | "reading";
}

const { title, description, eyebrow, layout = "wide" } = Astro.props;
const pathname = Astro.url.pathname;

const primaryNav = [
  { href: "/start/", label: "Start here" },
  { href: "/methods/", label: "Methods" },
  { href: "/compare/", label: "Compare" },
  { href: "/sources/", label: "Sources" },
];

const moreNav = [
  { href: "/invention/", label: "AI proposals" },
  { href: "/documents/", label: "Documents" },
  { href: "/glossary/", label: "Glossary" },
  { href: "/egypt/", label: "Egypt" },
  { href: "/research-method/", label: "About the evidence" },
  { href: "/limitations/", label: "Limitations" },
];

const isCurrent = (href: string): boolean =>
  pathname === href || (href !== "/" && pathname.startsWith(href));

// Some pages already carry the site suffix in their own title.
const pageTitle = title.endsWith("— Butt Lab") ? title : `${title} — Butt Lab`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the main content</a>

    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="brand" href="/" aria-current={isCurrent("/") ? "page" : undefined}
          ><span class="brand__mark" aria-hidden="true"></span>Butt Lab</a
        >
        <p class="site-header__tagline">Cigarette-butt recycling evidence</p>

        <button type="button" class="site-search-toggle" id="search-toggle" aria-expanded="false" aria-controls="search-form search-feedback" hidden>Search</button>
        <details class="nav-more">
          <summary>More</summary>
          <nav aria-label="More pages">
            <ul>
              {moreNav.map((item) => (
                <li><a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a></li>
              ))}
            </ul>
          </nav>
        </details>

        <form class="search" id="search-form" role="search" novalidate hidden>
          <label class="visually-hidden" for="search-input">Search the reader site</label>
          <input
            id="search-input"
            name="q"
            type="search"
            autocomplete="off"
            placeholder="Search Butt Lab"
          />
          <button type="submit">Search</button>
        </form>
      </div>

      <div class="shell site-search-feedback" id="search-feedback">
        <div id="search-status" class="search__status" role="status"></div>
        <div id="search-results" class="search__results" hidden>
          <ol id="search-hits" aria-label="Search results"></ol>
          <button class="search__clear" type="button" id="search-clear">Clear search</button>
        </div>
      </div>

      <nav class="shell nav-primary" aria-label="Primary">
        <ul>
          {
            primaryNav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? (pathname === item.href ? "page" : "location") : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

    </header>

    <main id="main" class:list={["shell", "page", { "page--reading": layout === "reading" }]} data-pagefind-body>
      {eyebrow && <p class="eyebrow page__eyebrow">{eyebrow}</p>}
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <p>
          Butt Lab is AI-assisted desk research. It does not assert that any method is safe or fit for use.
          No experiment was run by this project, and this site does not authorise one.
        </p>
        <nav class="site-footer__nav" aria-label="Footer">
          <ul>
            <li><a href="/start/">Start here</a></li>
            <li><a href="/methods/">Methods</a></li>
            <li><a href="/compare/">Compare evidence</a></li>
            <li><a href="/invention/">AI proposals</a></li>
            <li><a href="/sources/">Sources</a></li>
            <li><a href="/glossary/">Glossary</a></li>
            <li><a href="/egypt/">Egypt</a></li>
            <li><a href="/research-method/">About the evidence</a></li>
            <li><a href="/limitations/">Limitations</a></li>
          </ul>
        </nav>
      </div>
    </footer>

    <noscript>
      <div class="shell">
        <p class="callout">
          <span class="callout__label">Search needs JavaScript</span>
          Browse the <a href="/methods/">methods</a>, the <a href="/sources/">sources</a> and the
          <a href="/glossary/">glossary</a> instead. Everything on this site is readable without
          JavaScript.
        </p>
      </div>
    </noscript>

    <script>
      import "../scripts/search";
      import "../scripts/terms";
    </script>
  </body>
</html>
