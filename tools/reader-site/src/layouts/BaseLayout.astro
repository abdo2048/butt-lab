---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
  title: string;
  description: string;
  recordId?: string;
  eyebrow?: string;
}

const { title, description, recordId, eyebrow } = Astro.props;
const pathname = Astro.url.pathname;

const primaryNav = [
  { href: "/start/", label: "Start here" },
  { href: "/methods/", label: "Methods" },
  { href: "/compare/", label: "Compare evidence" },
  { href: "/sources/", label: "Sources" },
  { href: "/glossary/", label: "Glossary" },
];

const secondaryNav = [
  { href: "/invention/", label: "New invention" },
  { href: "/egypt/", label: "Egypt annex" },
  { href: "/research-method/", label: "How the research was produced" },
  { href: "/limitations/", label: "Audit links and limitations" },
];

const isCurrent = (href: string): boolean =>
  pathname === href || (href !== "/" && pathname.startsWith(href));

// Some pages already carry the site suffix in their own title.
const pageTitle = title.endsWith("— Butt Lab") ? title : `${title} — Butt Lab`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the main content</a>

    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="brand" href="/" aria-current={isCurrent("/") ? "page" : undefined}
          ><span class="brand__mark" aria-hidden="true"></span>Butt Lab</a
        >
        <p class="site-header__tagline">Cigarette-butt recycling evidence</p>

        <form class="search" id="search-form" role="search" novalidate>
          <label class="visually-hidden" for="search-input">Search the reader site</label>
          <input
            id="search-input"
            name="q"
            type="search"
            autocomplete="off"
            placeholder="Search methods, sources, terms"
          />
          <button type="submit">Search</button>
          <p class="search__status" id="search-status" role="status"></p>
        </form>
      </div>

      <nav class="shell nav-primary" aria-label="Primary">
        <ul>
          {
            primaryNav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="shell nav-secondary" aria-label="Secondary">
        <ul>
          {
            secondaryNav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main" class="shell page" data-pagefind-body>
      {
        (eyebrow || recordId) && (
          <div class="sheet__margin">
            {eyebrow && <p class="eyebrow">{eyebrow}</p>}
            {recordId && <p class="record-id">{recordId}</p>}
          </div>
        )
      }
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <p>
          Butt Lab is a desk research knowledge base of cigarette-butt recycling methods.
          Claims, assessments, gaps and hypotheses carry their evidence state; sources,
          terms, method families and the material record carry the role they play
          instead. Everything the research assistant added is marked as an AI-generated
          assumption. It does not assert that any method is safe,
          clean, validated, costed, or novel, and it does not authorise any experiment. Nothing
          on this site has been experimentally validated.
        </p>
        <nav class="site-footer__nav" aria-label="Footer">
          <ul>
            <li><a href="/start/">Start here</a></li>
            <li><a href="/methods/">Methods</a></li>
            <li><a href="/compare/">Compare evidence</a></li>
            <li><a href="/sources/">Sources</a></li>
            <li><a href="/glossary/">Glossary</a></li>
            <li><a href="/research-method/">How the research was produced</a></li>
          </ul>
        </nav>
      </div>
    </footer>

    <noscript>
      <div class="shell">
        <p class="callout">
          <span class="callout__label">Search needs JavaScript</span>
          Browse the <a href="/methods/">methods</a>, the <a href="/sources/">sources</a> and the
          <a href="/glossary/">glossary</a> instead. Everything on this site is readable without
          JavaScript.
        </p>
      </div>
    </noscript>

    <script>
      import "../scripts/search";
      import "../scripts/terms";
    </script>
  </body>
</html>
