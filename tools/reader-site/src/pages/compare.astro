---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBundle, recordsOfKind } from "../lib/bundle.ts";
import {
  assessmentFor,
  sortByCriterion,
  type AssessmentView,
  type ComparisonRow,
} from "../lib/compare.ts";
import { basisLabel, criterionLabel, scoreSummary } from "../lib/format.ts";

const bundle = getBundle();
const families = recordsOfKind(bundle, "method-family").sort((a, b) =>
  a.title.localeCompare(b.title),
);

const rows: ComparisonRow[] = families.map((family) => {
  const assessments: Record<string, AssessmentView> = {};
  for (const assessmentId of family.assessmentIds) {
    const record = bundle.records.get(assessmentId);
    if (record === undefined || record.kind !== "assessment") continue;
    assessments[record.criterionId] = {
      id: record.id,
      methodId: record.methodId,
      criterionId: record.criterionId,
      status: record.status,
      ...(record.score !== undefined ? { score: record.score } : {}),
      ...(record.label !== undefined ? { label: record.label } : {}),
      ...(record.basis !== undefined ? { basis: record.basis } : {}),
      ...(record.rationale !== undefined ? { rationale: record.rationale } : {}),
      ...(record.unknownReason !== undefined ? { unknownReason: record.unknownReason } : {}),
      ...(record.notApplicableReason !== undefined
        ? { notApplicableReason: record.notApplicableReason }
        : {}),
    };
  }
  return { methodId: family.id, title: family.title, assessments };
});

const criterionIds: string[] = [];
for (const family of families) {
  for (const assessmentId of family.assessmentIds) {
    const record = bundle.records.get(assessmentId);
    if (record && record.kind === "assessment" && !criterionIds.includes(record.criterionId)) {
      criterionIds.push(record.criterionId);
    }
  }
}

// Reader-facing questions are summaries of the existing scoring criteria, not a new rubric.
const criterionQuestions: Record<string, { label: string; description: string }> = {
  "evidence-strength": { label: "Evidence strength", description: "How relevant, direct and independent is the evidence?" },
  "process-ease": { label: "Process difficulty", description: "How complex are the steps, equipment, controls and outside services the method needs?" },
  "resource-burden": { label: "Resources and waste", description: "How much water, energy and material does it use, and how much waste does it generate on a comparable basis?" },
  "contaminant-fate-coverage": { label: "Where contaminants go", description: "How well are individual contaminants tracked in the product, wastewater, solid waste, emissions and other outputs?" },
  "sink-completeness": { label: "What accepts the outputs", description: "Is each output’s intended use or final destination named, and who accepts it under what requirements?" },
  "product-readiness": { label: "Evidence for product use", description: "What is known about product quality, performance, and leaching or exposure for the intended use?" },
  "regulatory-clarity": { label: "Applicable rules", description: "Are the jurisdiction, relevant authority and route to regulatory acceptance known?" },
  "validation-maturity": { label: "What still needs testing", description: "Are basic questions still unresolved, or is the remaining work a specific test against defined criteria?" },
};
const displayCriterion = (id: string) => criterionQuestions[id]?.label ?? criterionLabel(id);

const orders: Record<string, Record<string, string[]>> = {};
for (const criterionId of criterionIds) {
  orders[criterionId] = {
    default: sortByCriterion(rows, criterionId, "default").map((row) => row.methodId),
    "evidence-gaps": sortByCriterion(rows, criterionId, "evidence-gaps").map((row) => row.methodId),
  };
}

const rowFor = (methodId: string): ComparisonRow =>
  rows.find((row) => row.methodId === methodId) as ComparisonRow;
---

<BaseLayout
  title="Compare the evidence"
  description="Compare the six method families one criterion at a time. Scores are never combined into one number, and unknown is never treated as zero."
  eyebrow="Comparison"
>
  <h1>Compare the evidence</h1>
  <p class="page__lede">Compare recycling methods one criterion at a time, or view all eight side by side. There is no combined score or overall ranking.</p>
  <section aria-label="Method comparison">
    <div class="compare-controls">
      <div class="control compare-question">
        <label for="compare-criterion">Compare one question at a time</label>
        <select id="compare-criterion" name="criterion" aria-describedby="compare-criterion-help">
          <option value="">Show all criteria (A–Z)</option>
          {
            criterionIds.map((criterionId) => (
              <option value={criterionId} data-description={criterionQuestions[criterionId]?.description}>{displayCriterion(criterionId)}</option>
            ))
          }
        </select>
        <p id="compare-criterion-help" class="small muted compare-question__help">Pick a question to see just those results and unlock sorting and filters.</p>
      </div>
      <div class="compare-options" id="compare-options" hidden>
        <p class="control">
          <label for="compare-mode">Order</label>
          <select id="compare-mode" name="mode" disabled>
            <option value="default">Scored first, unknown last</option>
            <option value="evidence-gaps">Unknown first</option>
          </select>
        </p>
        <p class="control">
          <label for="compare-status">Show only</label>
          <select id="compare-status" name="status" disabled>
            <option value="">All results</option>
            <option value="scored">Scored</option>
            <option value="unknown">Unknown</option>
            <option value="not-applicable">Not applicable</option>
          </select>
        </p>
        <p class="control">
          <label for="compare-basis">Evidence basis</label>
          <select id="compare-basis" name="basis" disabled>
            <option value="">Every basis</option>
            <option value="source-supported">Source-supported</option>
            <option value="inference">Inference</option>
            <option value="ai-assessed-human-reviewed">AI assessed, human reviewed</option>
          </select>
        </p>
      </div>
    </div>

    <details class="drawer compare-guide">
      <summary>What do the criteria mean?</summary>
      <div class="drawer__body">
        <dl>
          {criterionIds.map((id) => (
            <>
              <dt><strong>{displayCriterion(id)}</strong>{displayCriterion(id) !== criterionLabel(id) && <span class="small muted"> ({criterionLabel(id)})</span>}</dt>
              <dd>{criterionQuestions[id]?.description}</dd>
            </>
          ))}
        </dl>
      </div>
    </details>

    <p class="mode-note">A low score is not the same as <strong>Unknown</strong>. Unknown means the available evidence did not answer the question.</p>
    <p id="compare-status-message" class="compare-status small muted" role="status"></p>
    <p id="compare-empty" class="callout callout--neutral" hidden>No methods match these filters. Try another result state or evidence basis.</p>

    <div class="compare-table">
      <p class="small muted compare-scroll-hint" hidden>Scroll the table sideways to see all criteria.</p>
      <div class="table-scroll" tabindex="0" role="group" aria-label="Method comparison table">
        <table class="table table--scores" id="compare-table">
          <caption class="visually-hidden">
            The six method families against the eight assessment criteria. Each cell carries
            the result state and the evidence basis of the assessment behind it.
          </caption>
          <thead>
            <tr>
              <th scope="col">Method family</th>
              {
                criterionIds.map((criterionId) => (
                  <th scope="col" data-criterion={criterionId}>{displayCriterion(criterionId)}</th>
                ))
              }
            </tr>
          </thead>
          <tbody id="compare-rows">
            {
              families.map((family) => {
                const row = rowFor(family.id);
                return (
                  <tr data-method-id={family.id}>
                    <th scope="row">
                      <a href={`/methods/${family.id}/`}>{family.title}</a>
                    </th>
                    {criterionIds.map((criterionId) => {
                      const assessment = assessmentFor(row, criterionId);
                      return (
                        <td
                          data-criterion={criterionId}
                          data-status={assessment.status}
                          data-basis={assessment.basis ?? ""}
                        >
                          <span class="compare-score">{scoreSummary(assessment)}</span>
                          {assessment.basis && <span class="small muted">{basisLabel(assessment.basis)}</span>}
                        </td>
                      );
                    })}
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </div>

    <ul class="compare-cards" id="compare-cards">
      {
        families.map((family) => {
          const row = rowFor(family.id);
          return (
            <li class="compare-card" data-method-id={family.id}>
              <h2>
                <a href={`/methods/${family.id}/`}>{family.title}</a>
              </h2>
              <dl class="audit-list">
                {criterionIds.map((criterionId) => {
                  const assessment = assessmentFor(row, criterionId);
                  return (
                    <>
                      <dt data-criterion={criterionId}>{displayCriterion(criterionId)}</dt>
                      <dd data-criterion={criterionId}>
                        {scoreSummary(assessment)}{" "}
                        {assessment.basis && <span class="small muted compare-card__basis">{basisLabel(assessment.basis)}</span>}
                      </dd>
                    </>
                  );
                })}
              </dl>
            </li>
          );
        })
      }
    </ul>

    <p class="small muted">
      These scores are assessments, not measurements. Open a method to read the rationale and see the supporting records.
    </p>
  </section>

  <script id="compare-order" type="application/json" set:html={JSON.stringify(orders)}></script>

  <script is:inline>
    (function () {
      var orderNode = document.getElementById("compare-order");
      var criterionSelect = document.getElementById("compare-criterion");
      var modeSelect = document.getElementById("compare-mode");
      var options = document.getElementById("compare-options");
      var criterionHelp = document.getElementById("compare-criterion-help");
      var defaultHelp = criterionHelp.textContent;
      var statusSelect = document.getElementById("compare-status");
      var basisSelect = document.getElementById("compare-basis");
      var tableBody = document.getElementById("compare-rows");
      var cardList = document.getElementById("compare-cards");
      var message = document.getElementById("compare-status-message");
      var empty = document.getElementById("compare-empty");
      if (!orderNode || !criterionSelect || !modeSelect || !statusSelect || !basisSelect || !tableBody) return;

      var orders;
      try {
        orders = JSON.parse(orderNode.textContent || "{}");
      } catch (error) {
        return;
      }
      if (!orders || typeof orders !== "object") return;

      // The sorting and filtering controls stay hidden until this script is running,
      // so a reader without JavaScript gets the complete unsorted table instead of
      // controls that would do nothing.
      document.documentElement.classList.add("has-js");

      var tableView = tableBody.closest(".compare-table");
      var tableScroller = tableView.querySelector(".table-scroll");
      var scrollHint = tableView.querySelector(".compare-scroll-hint");
      function updateScrollHint() {
        scrollHint.hidden = tableScroller.scrollWidth <= tableScroller.clientWidth;
      }
      if (typeof ResizeObserver !== "undefined") {
        var tableResize = new ResizeObserver(updateScrollHint);
        tableResize.observe(tableScroller);
        tableResize.observe(tableBody.closest("table"));
      } else {
        window.addEventListener("resize", updateScrollHint);
      }
      var alphabetical = Array.from(tableBody.rows, function (row) { return row.dataset.methodId; });
      var criterionNodes = document.querySelectorAll("[data-criterion]");

      function orderFor(criterion, mode) {
        if (!criterion || !orders[criterion]) return alphabetical;
        var wanted = mode === "evidence-gaps" ? orders[criterion]["evidence-gaps"] : orders[criterion]["default"];
        return wanted || null;
      }

      function place(container, wanted) {
        if (!container || !wanted) return;
        var items = Array.prototype.slice.call(
          container.querySelectorAll("[data-method-id]"),
        );
        items.sort(function (left, right) {
          var leftIndex = wanted.indexOf(left.getAttribute("data-method-id"));
          var rightIndex = wanted.indexOf(right.getAttribute("data-method-id"));
          if (leftIndex === -1) leftIndex = items.length;
          if (rightIndex === -1) rightIndex = items.length;
          return leftIndex - rightIndex;
        });
        items.forEach(function (item) {
          container.appendChild(item);
        });
      }

      function apply() {
        var criterion = criterionSelect.value;
        var mode = modeSelect.value;
        var wanted = orderFor(criterion, mode);
        options.hidden = !criterion;
        criterionHelp.textContent = criterionSelect.selectedOptions[0].dataset.description || defaultHelp;
        place(tableBody, wanted);
        place(cardList, wanted);

        [modeSelect, statusSelect, basisSelect].forEach(function (control) {
          control.disabled = !criterion;
          if (!criterion) control.selectedIndex = 0;
        });
        criterionNodes.forEach(function (node) {
          node.hidden = Boolean(criterion && node.dataset.criterion !== criterion);
        });

        var status = statusSelect.value;
        var basis = basisSelect.value;
        var rows = Array.prototype.slice.call(tableBody.querySelectorAll("tr"));
        rows.forEach(function (row) {
          var cell = criterion
            ? row.querySelector('td[data-criterion="' + criterion + '"]')
            : null;
          if (!cell) {
            row.hidden = false;
            return;
          }
          var rowStatus = cell.getAttribute("data-status") || "";
          var rowBasis = cell.getAttribute("data-basis") || "";
          row.hidden = (status && rowStatus !== status) || (basis && rowBasis !== basis);
        });

        var cards = cardList ? Array.prototype.slice.call(cardList.children) : [];
        cards.forEach(function (card) {
          var row = tableBody.querySelector(
            'tr[data-method-id="' + card.getAttribute("data-method-id") + '"]',
          );
          card.hidden = row ? row.hidden : false;
        });
        var count = rows.filter(function (row) { return !row.hidden; }).length;
        tableView.hidden = count === 0;
        updateScrollHint();
        if (cardList) cardList.hidden = count === 0;
        if (empty) empty.hidden = count !== 0;
        if (message) message.textContent = criterion
          ? "Showing " + count + " of " + rows.length + " methods for " + criterionSelect.selectedOptions[0].textContent + "."
          : "Showing all " + count + " methods.";
      }

      criterionSelect.addEventListener("change", apply);
      modeSelect.addEventListener("change", apply);
      statusSelect.addEventListener("change", apply);
      basisSelect.addEventListener("change", apply);
      apply();
    })();
  </script>
</BaseLayout>
