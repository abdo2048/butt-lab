---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBundle, recordsOfKind } from "../lib/bundle";
import { evidenceStateLabel } from "../lib/format";
import { scenarios } from "../lib/recovery-scenario";
import type { GapRecord, SourceRecord } from "../lib/types";

const bundle = getBundle();
const hypotheses = recordsOfKind(bundle, "hypothesis");
const candidate = hypotheses.find((hypothesis) => hypothesis.id === "split-before-washing");
if (!candidate) throw new Error("Featured hypothesis is missing from the publication bundle");
const earlier = hypotheses.filter((hypothesis) => hypothesis !== candidate);
const percent = (fraction: number) => `${Math.round(fraction * 100)}%`;

const validationQuestions = (ids: string[]) =>
  ids
    .map((id) => bundle.records.get(id))
    .filter((record): record is GapRecord => record?.kind === "gap");

const sourceInputs = (ids: string[]) =>
  ids
    .map((id) => bundle.records.get(id))
    .filter((record): record is SourceRecord => record?.kind === "source");
---

<BaseLayout title="AI proposals" description="A candidate cigarette-butt recycling route, assumptions, a sensitivity calculation and earlier proposals.">
  <header class="proposal-reading">
    <p class="eyebrow page__eyebrow">Ideas to test</p>
    <h1>AI proposals for recycling cigarette butts</h1>
    <p class="page__lede">These are unvalidated hypotheses, not recipes or claims of novelty. Butt Lab has not run an experiment. Each proposal explains its assumptions and what would make a qualified team revise or reject it.</p>
    <nav class="page-actions" aria-label="Explore the proposals">
      <a class="action action--primary" href={`#${candidate.id}`}>Read the proposal</a>
      <a class="action action--quiet" href="#scenario">See the calculation</a>
    </nav>
  </header>

  <section class="section proposal-reading proposal-feature" aria-labelledby={candidate.id}>
    <span class="chip chip--ai">AI hypothesis · Unvalidated</span>
    <h2 id={candidate.id}>{candidate.title}</h2>
    <p>{candidate.priorContext}</p>
    <p>{candidate.mechanism}</p>
    <p><strong>Sources that informed it:</strong></p>
    <ul>{sourceInputs(candidate.sourceInputIds).map((source) => <li><a href={`/sources/${source.id}/`}>{source.title}</a></li>)}</ul>
    <h3>What it assumes</h3>
    <ul>{candidate.assumptions.map((assumption) => <li>{assumption}</li>)}</ul>
    <h3>What would make us reject or revise it?</h3>
    <ul>{candidate.falsifiers.map((falsifier) => <li>{falsifier}</li>)}</ul>
    <p><strong>Still needed:</strong> {candidate.unresolvedDependencies.join(" ")}</p>
  </section>

  <section class="section" aria-labelledby="scenario">
    <div class="proposal-reading prose">
      <h2 id="scenario">When might early separation help?</h2>
      <p class="eyebrow">Illustrative calculation · not measured</p>
      <p>Below is a bookkeeping exercise for one hypothetical contaminant, not a prediction or a safe operating target. Start with one unit of contaminant and one unit of recoverable filter mass. Let <var>L</var> be the fraction of the contaminant that reaches the wash, <var>W</var> the fraction of that load transferred into wash waste, and <var>R</var> the fraction of filter mass recovered at the end.</p>
      <p>The simplified model assigns <strong>1 − L</strong> to early rejects, <strong>L × W</strong> to wash waste, and <strong>L × (1 − W)</strong> to recovered material. Divide the last term by <strong>R</strong> to compare the burden per unit of recovered filter. For illustration, <var>W</var> is 50% in every row. The model has no air losses or measurement uncertainty; real work must account for both.</p>
    </div>
    <div class="table-scroll proposal-table" tabindex="0" role="region" aria-label="Illustrative wash comparison">
      <table class="table">
        <thead><tr><th scope="col">Assumed case</th><th scope="col">Filter recovered</th><th scope="col">Load in rejects</th><th scope="col">Load in wash waste</th><th scope="col">Load retained</th><th scope="col">Load per unit recovered filter</th></tr></thead>
        <tbody>{scenarios.map((row) => <tr><th scope="row">{row.label}</th><td>{percent(row.filterRecovery)}</td><td>{percent(row.earlyReject)}</td><td>{percent(row.washWaste)}</td><td>{percent(row.retainedLoad)}</td><td>{row.loadPerRecoveredFilter?.toFixed(3) ?? "Undefined"}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="proposal-reading callout callout--neutral">Notice the last row: the wash carries less of the contaminant, yet the recovered filter carries more per unit of mass. That is why both the contaminant split and filter recovery need measuring. In an actual study, uncharacterised cadmium, lead, arsenic or mercury stays a stop condition even if the total mass balances.</p>
  </section>

  <details class="drawer proposal-reading earlier-proposals">
    <summary>Earlier AI proposals and evidence-gap notes</summary>
    <div class="drawer__body">
    {
    earlier.map((hypothesis) => (
      <article class="section" id={hypothesis.id}>
        <div class="section__heading">
          <h2>{hypothesis.title}</h2>
        </div>

        <p class="page__lede">{hypothesis.visibleLabel}</p>

        <dl class="audit-list">
          <dt>Validation state</dt>
          <dd>
            <span class="chip chip--ai">UNVALIDATED HYPOTHESIS</span>{" "}
            <span class="mono small">{hypothesis.validationState}</span>
          </dd>
          <dt>Evidence state</dt>
          <dd>{evidenceStateLabel(hypothesis.evidenceState)}</dd>
          <dt>Record version</dt>
          <dd class="mono">{hypothesis.recordVersion}</dd>
          <dt>Reviewer</dt>
          <dd>{hypothesis.reviewer}</dd>
        </dl>

        <div class="prose">
          <h3>The mechanism it proposes</h3>
          <p>{hypothesis.mechanism}</p>
          <h3>What it starts from</h3>
          <p>{hypothesis.priorContext}</p>
        </div>

        {hypothesis.assumptions.length > 0 && (
          <div class="prose">
            <h3>Assumptions it rests on</h3>
            <ul>
              {hypothesis.assumptions.map((assumption) => (
                <li>{assumption}</li>
              ))}
            </ul>
          </div>
        )}

        {hypothesis.failureModes.length > 0 && (
          <div class="prose">
            <h3>How it fails</h3>
            <ul>
              {hypothesis.failureModes.map((failure) => (
                <li>{failure}</li>
              ))}
            </ul>
          </div>
        )}

        {hypothesis.falsifiers.length > 0 && (
          <div class="prose">
            <h3>What would kill it</h3>
            <ul>
              {hypothesis.falsifiers.map((falsifier) => (
                <li>{falsifier}</li>
              ))}
            </ul>
          </div>
        )}

        {hypothesis.unresolvedDependencies.length > 0 && (
          <div class="prose">
            <h3>What it still depends on</h3>
            <ul>
              {hypothesis.unresolvedDependencies.map((dependency) => (
                <li>{dependency}</li>
              ))}
            </ul>
          </div>
        )}

        {validationQuestions(hypothesis.validationQuestionIds).length > 0 && (
          <div class="prose">
            <h3>Open questions it would have to answer</h3>
            <ul>
              {validationQuestions(hypothesis.validationQuestionIds).map((question) => (
                <li>
                  {question.question}{" "}
                  <span class="mono small">
                    {question.validationState} · {question.nextHumanWork}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {sourceInputs(hypothesis.sourceInputIds).length > 0 && (
          <div class="prose">
            <h3>The published record it starts from</h3>
            <ul>
              {sourceInputs(hypothesis.sourceInputIds).map((source) => (
                <li>
                  <a href={`/sources/${source.id}/`}>{source.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {hypothesis.auditReferences.length > 0 && (
          <details class="drawer">
            <summary>Audit trail</summary>
            <div class="drawer__body">
              <dl class="audit-list">
                <dt>Record id</dt>
                <dd class="mono">{hypothesis.id}</dd>
                {hypothesis.auditAliases.length > 0 && (
                  <>
                    <dt>Internal names</dt>
                    <dd class="mono">{hypothesis.auditAliases.join(", ")}</dd>
                  </>
                )}
                <dt>Public records</dt>
                <dd>
                  {hypothesis.auditReferences.map((reference) => (
                    <span class="small">
                      <a href={reference.url} rel="noreferrer noopener">
                        {reference.label}
                      </a>{" "}
                      <span class="mono">
                        version {reference.version} · {reference.internalId}
                      </span>
                    </span>
                  ))}
                </dd>
                <dt>Publication state</dt>
                <dd>{hypothesis.publicationState}</dd>
                <dt>Schema version</dt>
                <dd class="mono">{hypothesis.schemaVersion}</dd>
              </dl>
            </div>
          </details>
        )}
      </article>
    ))
  }
    </div>
  </details>
</BaseLayout>
