---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getBundle, recordsOfKind } from "../../lib/bundle";

const bundle = getBundle();
const families = recordsOfKind(bundle, "method-family");
const familyById = new Map(families.map((family) => [family.id, family]));

// Brief reader-facing descriptions of existing family records and open questions.
// The detailed evidence and qualifications stay on the linked method pages.
const introductions = {
  "mechanical-physical": {
    approach: "Separate the filter from the rest of the butt and wash the fibres.",
    question: "What ends up in the wash water or discarded solids, and what stays in the fibre?",
  },
  chemical: {
    approach: "Dissolve the filter plastic to separate it from other material, then recover it as a solid.",
    question: "What contaminants remain in the used solvent, and how can that waste be managed?",
  },
  thermal: {
    approach: "Blend dried butt material into plastic and form it into a composite, without washing first.",
    question: "Can contaminants escape as the composite ages in rain, heat, or sunlight?",
  },
  "material-incorporation": {
    approach: "Use butt material as an ingredient in a construction material such as bricks or asphalt.",
    question: "Do contaminants escape during manufacturing or over the product’s lifetime?",
  },
  biological: {
    approach: "Use enzymes or microorganisms to break down or modify parts of the butt.",
    question: "Do nicotine and other residues break down, change into other compounds, or move into the treatment medium?",
  },
  "product-routes": {
    approach: "Explore potential uses for recovered butt material. This is a survey of end uses, not a treatment process.",
    question: "Which product requirements would each candidate use have to meet?",
  },
};

const cards = Object.entries(introductions).flatMap(([id, introduction]) => {
  const family = familyById.get(id);
  return family ? [{ family, ...introduction }] : [];
});
// Don't hide newly published families before their short introductions are written.
for (const family of families) {
  if (!Object.hasOwn(introductions, family.id)) {
    const gap = bundle.records.get(family.gapIds[0] ?? "");
    cards.push({ family, approach: family.summary, question: gap?.kind === "gap" ? gap.question : "" });
  }
}

// F0 is written as its own page rather than as a bundle record, so it is listed
// here by hand. Keep the wording aligned with that page.
const stagedWashing = {
  title: "Staged water and ethanol washing",
  href: "/methods/staged-washing/",
  approach: "Wash the whole butt in water, then optionally in ethanol, dry it and mill the fibre.",
  output: "Washed cellulose-acetate fibre",
  question: "Does the wash remove metals from the fibre, or only move them into the wash water and sludge?",
};
---

<BaseLayout
  title="Cigarette-butt recycling methods"
  description="Browse cigarette-butt treatment methods, the materials they aim to produce, and what the evidence has yet to answer."
  eyebrow="Research guide"
  layout="catalogue"
>
  <h1>Recycling methods</h1>
  <p class="page__lede">
    These are the reference pages behind each row of the
    <a href="/compare/">comparison table</a>: what each route takes in, what it aims to produce,
    and what the evidence has yet to answer. Use the table to see the routes side by side first;
    come here for the detail on one route.
  </p>

  <nav class="page-actions" aria-label="Related ways to explore">
    <a class="action action--primary" href="/compare/">Back to the comparison table</a>
    <a class="action action--quiet" href="/methods/examples/">Worked examples</a>
  </nav>

  <ul class="family-grid" aria-label="Method families">
    <li>
      <h2><a href={stagedWashing.href}>{stagedWashing.title}</a></h2>
      <p>{stagedWashing.approach}</p>
      <dl class="family-grid__details">
        <dt>Target output</dt>
        <dd>{stagedWashing.output}</dd>
        <dt>Open question</dt>
        <dd>{stagedWashing.question}</dd>
      </dl>
    </li>
    {cards.map(({ family, approach, question }) => (
      <li>
        <h2><a href={`/methods/${family.id}/`}>{family.title}</a></h2>
        <p>{approach}</p>
        <dl class="family-grid__details">
          {family.products.length > 0 && (
            <>
              <dt>{family.id === "product-routes" ? "Possible outputs" : "Target output"}</dt>
              <dd>{family.products.map((product) => product.label).join("; ")}</dd>
            </>
          )}
          {question && (
            <>
              <dt>Open question</dt>
              <dd>{question}</dd>
            </>
          )}
        </dl>
      </li>
    ))}
  </ul>
</BaseLayout>
