---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getBundle, recordsOfKind } from "../../lib/bundle";
import { rightsLabel } from "../../lib/format";

const bundle = getBundle();
const sources = recordsOfKind(bundle, "source")
  .slice()
  .sort((a, b) => a.title.localeCompare(b.title));
---

<BaseLayout
  title="Sources — Butt Lab"
  description="Every source in the published layer, with its citation, its rights state and the claims that rest on it."
  eyebrow="Sources"
>
  <h1>Sources</h1>

  <p class="page__lede">
    {sources.length} sources back the published layer. Each one is shown with its citation, the
    version or date it was read at, the date it was accessed, and its rights state. A link here
    is a link to the original: the link-only entries are cited, not copied, so nothing on this
    site republishes a source that was never cleared for redistribution.
  </p>

  <ul class="record-list">
    {
      sources.map((source) => (
        <li class="source-card">
          <h2>
            <a href={`/sources/${source.id}/`}>{source.title}</a>
          </h2>
          <p class="small">{source.citation}</p>
          <p class="mono small">
            {source.sourceType} · {source.versionOrDate} · accessed {source.accessDate} ·{" "}
            {rightsLabel(source.rights)}
          </p>
          <p class="small">
            <a href={source.originalUrl} rel="noreferrer noopener">
              Open the source
            </a>
          </p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
