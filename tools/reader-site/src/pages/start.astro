---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBundle, recordsOfKind, terms } from "../lib/bundle";
import { renderMarkdown, splitPage } from "../lib/markdown";
import type { MaterialRecord } from "../lib/types";

const bundle = getBundle();
const glossaryTerms = terms(bundle);
const page = bundle.pages.get("start-here");
if (!page) throw new Error("the start-here page is missing from the bundle");
const parsed = splitPage(page.markdown);
const material = bundle.records.get("cigarette-butt") as MaterialRecord | undefined;
const families = recordsOfKind(bundle, "method-family").length;
---

<BaseLayout
  title={`Start here — ${parsed.title}`}
  description="What a cigarette butt contains, the six method families, how the evidence labels work, and where the open questions are."
  eyebrow="Start here"
>
  <h1>{parsed.title}</h1>
  <div class="prose" set:html={renderMarkdown(parsed.preamble, { terms: glossaryTerms })} />

  {
    material && (
      <section class="section" aria-labelledby="the-material">
        <div class="section__heading">
          <h2 id="the-material">The material on the record</h2>
          <p class="section__note">The published material record, in full.</p>
        </div>
        <dl class="audit-list">
          <div>
            <dt>Description</dt>
            <dd>{material.description}</dd>
          </div>
          <div>
            <dt>Composition</dt>
            <dd>{material.compositionSummary}</dd>
          </div>
          <div>
            <dt>Contaminants carried</dt>
            <dd>{material.contaminants.join(", ")}</dd>
          </div>
          <div>
            <dt>Jurisdictions named</dt>
            <dd>{material.jurisdictions.join(", ")}</dd>
          </div>
          <div>
            <dt>Method families in scope</dt>
            <dd>{material.methodFamilyIds.length} of {families}</dd>
          </div>
          <div>
            <dt>Publication state</dt>
            <dd>{material.publicationState}</dd>
          </div>
        </dl>
      </section>
    )
  }

  {
    parsed.sections.map((section) => (
      <section class="section" aria-labelledby={section.slug}>
        <div class="section__heading">
          <h2 id={section.slug}>{section.heading}</h2>
        </div>
        <div class="prose" set:html={renderMarkdown(section.body, { terms: glossaryTerms })} />
      </section>
    ))
  }
</BaseLayout>
